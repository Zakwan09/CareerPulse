# Copy this file to .env and adjust values before running.

# --- Database ---------------------------------------------------------
# Leave unset (or delete this line) to use the built-in SQLite fallback at
# data/processed/careerpulse.db -- zero setup required.
#
# To use PostgreSQL instead (recommended for real datasets), install
# psycopg (see backend/requirements.txt) and set:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/careerpulse
DATABASE_URL=

# --- Auth --------------------------------------------------------------
# Generate a real random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
